# Local endpoint (Ollama or another OpenAI-compatible server).
LLM_BASE_URL=http://localhost:11434/v1
# Set the exact name of an installed model; no model is downloaded automatically.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_JSON_MODE=true
# Required when exposing the backend beyond your own machine.
BACKEND_API_KEY=
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
