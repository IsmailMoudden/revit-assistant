<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2024'">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2025'">2025.0.2</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2026'">2026.0.4</RevitApiVersion>
    <AssemblyName>BimAiAssistant</AssemblyName>
    <RootNamespace>BimAiAssistant</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API via NuGet — ExcludeAssets=runtime: DLLs not copied to output, Revit provides them at runtime -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="$(RevitApiVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="ValidateRevitVersion" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(RevitVersion)' != '2024' And '$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026'"
           Text="Unsupported RevitVersion. Choose 2024, 2025 or 2026." />
  </Target>

</Project>
